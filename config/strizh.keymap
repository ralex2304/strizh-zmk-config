#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

&sk { quick-release; };

&glidepoint_listener {
    input-processors = <&zip_xy_scaler 2 1>;

    scroller {
        layers = <2>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT) &zip_xy_to_scroll_mapper &zip_scroll_scaler 1 4>;
    };
};

/ {
    behaviors {
        sticky_tap: sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "STICKY_TAP";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "hold-preferred";
            hold-while-undecided;
            hold-while-undecided-linger;
        };

        lang_switch: lang_switch {
            compatible = "zmk,behavior-tap-dance";
            display-name = "LANG_SWITCH";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LG(SPACE)>;

            tapping-term-ms = <500>;
        };

        plus_minus_mm: plus_minus_mm {
            compatible = "zmk,behavior-mod-morph";
            display-name = "PLUS_MINUS_MM";
            bindings = <&kp PLUS>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mul_div_mm: mul_div_mm {
            compatible = "zmk,behavior-mod-morph";
            display-name = "MUL_DIV_MM";
            bindings = <&kp ASTERISK>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eq_dot_mm: eq_dot_mm {
            compatible = "zmk,behavior-mod-morph";
            display-name = "EQ_DOT_MM";
            bindings = <&kp EQUAL>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        prtsc_calc_mm: prtsc_calc_mm {
            compatible = "zmk,behavior-mod-morph";
            display-name = "PRTSC_CALC_MM";
            bindings = <&kp PRINTSCREEN>, <&kp K_CALC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        motion_mod_brightness: motion_mod_brightness {
            compatible = "zmk,behavior-mod-morph";
            display-name = "MOTION_MOD_BRIGHTNESS";
            bindings = <&kp C_BRIGHTNESS_INC>, <&kp C_BRIGHTNESS_DEC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        leader_m: leader_m {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
            display-name = "LEADER_KEY_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E          &kp R                      &kp T      &none                                 &kp Y        &kp U      &kp I         &kp O    &kp P     &kp MINUS
&kp LBKT   &kp A  &kp S  &kp D          &kp F                      &kp G      &none                                 &kp H        &kp J      &kp K         &kp L    &kp SEMI  &kp SQT
&kp RBKT   &kp Z  &kp X  &kp C          &kp V                      &kp B      &none                                 &kp N        &kp M      &kp COMMA     &kp DOT  &kp FSLH  &kp BACKSLASH
                         &mt LCTRL TAB  &sticky_tap LSHIFT LSHIFT  &lt 3 DEL  &kp BACKSPACE    &mo 1  &mt LALT ESC  &lt 4 SPACE  &kp ENTER  &lang_switch
            >;

            display-name = "Main";
        };

        touch_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mkp LCLK  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mkp RCLK  &mo 2   &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans  &mkp MCLK &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans  &trans
            >;

            display-name = "Touch";
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Scroll";
        };

        num_layer {
            bindings = <
&plus_minus_mm  &kp N6      &kp N7      &kp N8            &kp N9          &kp N0      &trans                    &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
&mul_div_mm     &kp N1      &kp N2      &kp N3            &kp N4          &kp N5      &trans                    &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F12
&eq_dot_mm      &kp LS(N1)  &kp LS(N2)  &kp LS(N3)        &kp LS(N4)      &kp LS(N5)  &trans                    &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &prtsc_calc_mm
                                        &trans            &trans          &trans      &trans    &trans  &trans  &trans      &trans      &trans
            >;

            display-name = "Num";
        };

        motion_layer {
            bindings = <
&trans  &kp LS(LC(Z))  &kp LS(LC(X))  &kp LS(LC(C))  &kp LS(LC(V))  &none                   &trans                               &none   &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none
&trans  &none          &mo 7          &mo 6          &mo 5          &none                   &trans                               &none   &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none
&trans  &kp LC(Z)      &kp LC(X)      &kp LC(C)      &kp LC(V)      &motion_mod_brightness  &trans                               &none   &kp H     &kp J          &kp K        &kp L      &none
                                      &trans         &trans         &lt (1) LC(DELETE)      &kp LC(BACKSPACE)    &trans  &trans  &trans  &trans    &trans
            >;

            display-name = "Motion";
        };

        cli_layer {
            bindings = <
&none  &none  &none  &none   &none   &none   &none                     &leader_m LC(S) LS(SQT)  &kp N0                     &kp LC(E)              &kp LC(Y)                  &kp LS(N4)                  &leader_m LC(S) LS(N5)
&none  &none  &none  &none   &none   &none   &none                     &leader_m LC(S) Z        &kp LC(H)                  &kp LC(J)              &kp LC(K)                  &kp LC(L)                   &leader_m G T
&none  &none  &none  &none   &none   &none   &none                     &leader_m LC(S) LBKT     &leader_m LC(W) LS(COMMA)  &leader_m LC(W) MINUS  &leader_m LC(W) LS(EQUAL)  &leader_m LC(W) LS(PERIOD)  &leader_m G LS(T)
                     &trans  &trans  &trans  &trans    &trans  &trans  &trans                   &trans                     &trans
            >;

            display-name = "CLI";
        };

        window_layer {
            bindings = <
&none  &none  &none  &none   &none   &none   &none                     &kp LG(PAGE_DOWN)  &kp LG(LEFT)      &kp LG(DOWN)          &kp LG(UP)             &kp LG(RIGHT)      &kp LG(PAGE_UP)
&none  &none  &none  &none   &none   &none   &none                     &kp LA(TAB)        &kp LA(LG(LEFT))  &kp LG(LS(LEFT))      &kp LG(LS(RIGHT))      &kp LA(LG(RIGHT))  &kp LC(TAB)
&none  &none  &none  &none   &none   &none   &none                     &kp LA(LS(TAB))    &kp LC(LA(LEFT))  &kp LC(LA(LS(LEFT)))  &kp LC(LA(LS(RIGHT)))  &kp LC(LA(RIGHT))  &kp LC(LS(TAB))
                     &trans  &trans  &trans  &trans    &trans  &trans  &trans             &trans            &trans
            >;

            display-name = "Win";
        };

        media_layer {
            bindings = <
&none  &none  &none  &none   &none   &none   &none                     &kp LC(F5)       &kp C_PREV    &kp C_PLAY_PAUSE  &kp K_MUTE  &kp C_NEXT    &kp F12
&none  &none  &none  &none   &none   &none   &none                     &kp LG(M)        &kp C_VOL_DN  &kp LG(F2)        &kp LG(F3)  &kp C_VOL_UP  &kp LC(TAB)
&none  &none  &none  &none   &none   &none   &none                     &kp PRINTSCREEN  &kp LC(T)     &kp LC(LS(T))     &kp F5      &kp LC(W)     &kp LC(LS(TAB))
                     &trans  &trans  &trans  &trans    &trans  &trans  &trans           &trans        &trans
            >;

            display-name = "Media";
        };

        misc_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 5  &out OUT_BLE                    &none   &none   &none  &none  &none  &none
&bt CAPS      &none         &none         &none         &studio_unlock  &none         &out OUT_USB                    &none   &none   &none  &none  &none  &none
&none         &none         &sys_reset    &bootloader   &none           &none         &bt BT_CLR                      &none   &none   &none  &none  &none  &none
                                          &trans        &trans          &trans        &trans          &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Misc";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        misc_layer {
            if-layers = <3 4>;
            then-layer = <8>;
        };
    };
};
