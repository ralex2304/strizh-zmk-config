#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout_col7_trackpad;
    };

    col7_trackpad_transform: col7_trackpad_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)                     RC(0,8)  RC(0,9)  RC(0,10)  RC(0,11)  RC(0,12)  RC(0,13)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)                     RC(1,8)  RC(1,9)  RC(1,10)  RC(1,11)  RC(1,12)  RC(1,13)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)                     RC(2,8)  RC(2,9)  RC(2,10)  RC(2,11)  RC(2,12)  RC(2,13)
                                       RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)   RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)
        >;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
    };

    physical_layout_col7_trackpad: physical_layout_col7_trackpad {
        compatible = "zmk,physical-layout";
        display-name = "7 Column - Trackpad";

        kscan = <&kscan0>;
        transform = <&col7_trackpad_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0  141       0     0     0>
            , <&key_physical_attrs 100 100  100  141       0     0     0>
            , <&key_physical_attrs 100 100  200   52       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   59       0     0     0>
            , <&key_physical_attrs 100 100  500   70       0     0     0>
            , <&key_physical_attrs 100 100  600   82       0     0     0>
            , <&key_physical_attrs 100 100 1000   70       0     0     0>
            , <&key_physical_attrs 100 100 1100   59       0     0     0>
            , <&key_physical_attrs 100 100 1200    0       0     0     0>
            , <&key_physical_attrs 100 100 1300   52       0     0     0>
            , <&key_physical_attrs 100 100 1400  141       0     0     0>
            , <&key_physical_attrs 100 100 1500  141       0     0     0>
            , <&key_physical_attrs 100 100    0  241       0     0     0>
            , <&key_physical_attrs 100 100  100  241       0     0     0>
            , <&key_physical_attrs 100 100  200  152       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  159       0     0     0>
            , <&key_physical_attrs 100 100  500  170       0     0     0>
            , <&key_physical_attrs 100 100  600  182       0     0     0>
            , <&key_physical_attrs 100 100 1000  170       0     0     0>
            , <&key_physical_attrs 100 100 1100  159       0     0     0>
            , <&key_physical_attrs 100 100 1200  100       0     0     0>
            , <&key_physical_attrs 100 100 1300  152       0     0     0>
            , <&key_physical_attrs 100 100 1400  241       0     0     0>
            , <&key_physical_attrs 100 100 1500  241       0     0     0>
            , <&key_physical_attrs 100 100    0  341       0     0     0>
            , <&key_physical_attrs 100 100  100  341       0     0     0>
            , <&key_physical_attrs 100 100  200  252       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  259       0     0     0>
            , <&key_physical_attrs 100 100  500  270       0     0     0>
            , <&key_physical_attrs 100 100  600  282       0     0     0>
            , <&key_physical_attrs 100 100 1000  270       0     0     0>
            , <&key_physical_attrs 100 100 1100  259       0     0     0>
            , <&key_physical_attrs 100 100 1200  200       0     0     0>
            , <&key_physical_attrs 100 100 1300  252       0     0     0>
            , <&key_physical_attrs 100 100 1400  341       0     0     0>
            , <&key_physical_attrs 100 100 1500  341       0     0     0>
            , <&key_physical_attrs 100 100  300  365       0     0     0>
            , <&key_physical_attrs 100 100  400  365       0     0     0>
            , <&key_physical_attrs 100 100  500  400       0     0     0>
            , <&key_physical_attrs 100 100  600  435       0     0     0>
            , <&key_physical_attrs 100 100  800  482       0     0     0>
            , <&key_physical_attrs 100 100  900  435       0     0     0>
            , <&key_physical_attrs 100 100 1000  400       0     0     0>
            , <&key_physical_attrs 100 100 1100  365       0     0     0>
            , <&key_physical_attrs 100 100 1200  365       0     0     0>
            ;
    };
};
